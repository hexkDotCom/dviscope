{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiError",
  "description": "The JSON body of every API error.",
  "type": "object",
  "properties": {
    "code": {
      "description": "Stable code.",
      "$ref": "#/$defs/ErrorCode"
    },
    "message": {
      "description": "Human-readable message (never contains log text, tokens or paths).",
      "type": "string"
    },
    "field": {
      "description": "The offending field, when there is one.",
      "type": [
        "string",
        "null"
      ]
    },
    "record": {
      "description": "The offending record of a batch, when there is one.",
      "type": [
        "string",
        "null"
      ]
    },
    "committed": {
      "description": "Whether anything was committed before the error.",
      "type": "boolean"
    },
    "correlation_id": {
      "description": "Correlation ID for logs.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "committed",
    "correlation_id"
  ],
  "$defs": {
    "ErrorCode": {
      "description": "A stable error code.",
      "oneOf": [
        {
          "description": "A field or record is invalid.",
          "type": "string",
          "const": "E_INVALID"
        },
        {
          "description": "The schema version is not the one this server accepts.",
          "type": "string",
          "const": "E_SCHEMA_VERSION"
        },
        {
          "description": "Missing or invalid credential.",
          "type": "string",
          "const": "E_UNAUTHENTICATED"
        },
        {
          "description": "The credential lacks a scope or role.",
          "type": "string",
          "const": "E_FORBIDDEN"
        },
        {
          "description": "The referenced object does not exist.",
          "type": "string",
          "const": "E_NOT_FOUND"
        },
        {
          "description": "Same revision with a different payload.",
          "type": "string",
          "const": "E_REVISION_CONFLICT"
        },
        {
          "description": "A newer revision exists.",
          "type": "string",
          "const": "E_STALE_REVISION"
        },
        {
          "description": "The edit was based on an older revision (`If-Match`); the response names the change.",
          "type": "string",
          "const": "E_PRECONDITION_FAILED"
        },
        {
          "description": "A retry whose exact inputs differ from the slot.",
          "type": "string",
          "const": "E_RETRY_INPUTS_DIFFER"
        },
        {
          "description": "The data is past retention.",
          "type": "string",
          "const": "E_EXPIRED"
        },
        {
          "description": "A replay older than the deduplication horizon.",
          "type": "string",
          "const": "E_REPLAY_EXPIRED"
        },
        {
          "description": "A request or record exceeds a published limit.",
          "type": "string",
          "const": "E_TOO_LARGE"
        },
        {
          "description": "Well-formed but not processable.",
          "type": "string",
          "const": "E_UNPROCESSABLE"
        },
        {
          "description": "A feature this version does not support.",
          "type": "string",
          "const": "E_NOT_SUPPORTED"
        },
        {
          "description": "Cookie and bearer credentials in one request.",
          "type": "string",
          "const": "E_MIXED_CREDENTIALS"
        },
        {
          "description": "Too many requests or bytes for this credential.",
          "type": "string",
          "const": "E_RATE_LIMITED"
        },
        {
          "description": "Unexpected server error.",
          "type": "string",
          "const": "E_INTERNAL"
        },
        {
          "description": "Server temporarily unavailable or overloaded.",
          "type": "string",
          "const": "E_UNAVAILABLE"
        },
        {
          "description": "Server storage above its high-water mark.",
          "type": "string",
          "const": "E_STORAGE_FULL"
        },
        {
          "description": "Client refused a non-HTTPS URL before sending credentials.",
          "type": "string",
          "const": "E_INSECURE_URL"
        }
      ]
    }
  }
}
